textures/q26_relay/floor
{
  qer_editorimage textures/q26_relay/floor.tga
  {
    map $lightmap
    rgbGen identity
  }
  {
    map textures/q26_relay/floor.tga
    blendFunc GL_DST_COLOR GL_ZERO
    rgbGen identity
  }
}

